@model Trident.Web.Core.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <div class="text-right"> 
        <a class="text-dark" asp-action="StartSync">Sync</a>&nbsp;&nbsp;
        @if (Model.ShowFeedList == true)
        {            
            <a class="text-dark" asp-action="Feed">Show Feeds</a>            
        }        
    </div>
    <br />
    
    @if (Model.ArticleList.Items.Count > 0)
    {
        <table class='table table-striped'>
            <thead>
            <tr>                
                <th>URL</th>                                
            </tr>
            </thead>
            <tbody>
                @foreach (var article in Model.ArticleList.Items)
            {
                <tr>                    
                    <td><a href="@article.Url" target="_blank">@article.Title</a></td>
                </tr>
            }
            </tbody>
        </table>
        <nav aria-label="paging">
            <ul class="pagination">
                @if (Model.ArticleList.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-currentPage="@Model.ArticleList.PreviousPage">Previous</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <a class="page-link">Previous</a>
                    </li>
                }
                @if (Model.ArticleList.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-currentPage="@Model.ArticleList.NextPage">Next</a>
                    </li>
                }
                else
                {
                    <li class="page-item disabled">
                        <a class="page-link">Next</a>
                    </li>
                }
            </ul>
        </nav>
    }
    else
    {
        <div class="alert-info form-control">
            No articles Found.  Click the sync button to get started.
        </div>
    }
</div>
