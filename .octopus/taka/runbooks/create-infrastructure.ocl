name = "Create Infrastructure"
cancel_queued_tasks = true
cancel_running_tasks = true
default_guided_failure_mode = "EnvironmentDefault"
description = <<-EOT
        **Action:** Create all the back-end infrastructure for this application.  Creates the namespace and database.
        
        **Affects:** The SQL Server and K8s hosting the application
        EOT
environment_scope = "FromProjectLifecycles"

connectivity_policy {
    allow_deployments_to_no_targets = true
}

run_retention_policy {
    type = "Default"
}

process {
    process_template "key-vault" {
        name = "Key Vault"
        process_template_slug = "key-vault-retrieve-secrets"
        version_mask = "2.X"

        parameter "KeyVault.Template.Vault.Name" {
            value = "#{KeyVault.Azure.Name}"
        }

        parameter "KeyVault.Template.Secrets.List" {
            value = "#{KeyVault.Azure.Secrets.List}"
        }

        parameter "KeyVault.Template.Worker.Pool" {
            value = "#{Core.Worker.Pool}"
        }

        parameter "KeyVault.Template.ExecutionContainer.Feed" {
            value = "Feeds-1283"
        }
    }

    process_template "create-database" {
        name = "Create Database"
        process_template_slug = "runbook-create-database-infrastructure"
        version_mask = "1.X"

        parameter "Template.SQLServer.Name" {
            value = "#{KeyVault.SQLServer.Server.Name}"
        }

        parameter "Template.SQLServer.User.Name" {
            value = "#{KeyVault.SQLServer.User.Name}"
        }

        parameter "Template.SQLServer.User.Password" {
            value = "#{KeyVault.SQLServer.User.Password}"
        }

        parameter "Template.SQLServer.Database.Name" {
            value = "#{Standards.Database.Name}"
        }

        parameter "Template.WorkerPool" {
            value = "#{Core.Worker.Pool}"
        }
    }

    process_template "create-container-infra" {
        name = "Create Container Infra"
        process_template_slug = "create-container-infrastructure"
        version_mask = "1.X"

        parameter "Template.Kubernetes.Namespace.Name" {
            value = "#{Standards.K8s.Namespace}"
        }

        parameter "Template.Kubernetes.TargetTags" {
            value = "trident-web"
        }
    }

    step "deploy-secrets" {
        name = "Deploy Secrets"
        properties = {
            Octopus.Action.TargetRoles = "trident-web"
        }

        action {
            action_type = "Octopus.KubernetesDeployRawYaml"
            properties = {
                Octopus.Action.GitRepository.Source = "External"
                Octopus.Action.Kubernetes.DeploymentTimeout = "180"
                Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
                Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
                Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
                Octopus.Action.KubernetesContainers.CustomResourceYamlFileName = "k8s/base/trident-app-secrets.yaml"
                Octopus.Action.KubernetesContainers.Namespace = "#{Standards.K8s.Namespace}"
                Octopus.Action.Package.JsonConfigurationVariablesTargets = "**/*.{yml,yaml}"
                Octopus.Action.Script.ScriptSource = "GitRepository"
            }
            worker_pool = "homelab-k8s"
            worker_pool_variable = ""

            git_dependencies {
                default_branch = "main"
                file_path_filters = ["k8s/base/trident-app-secrets.yaml"]
                git_credential_type = "GitHub"
                github_connection_id = "GitHubAppConnections-1"
                repository_uri = "https://github.com/BobJWalker/Trident.git"
            }
        }
    }

    step "deploy-argo-application" {
        name = "Deploy Argo Application"
        properties = {
            Octopus.Action.TargetRoles = "trident-web"
        }

        action {
            action_type = "Octopus.KubernetesDeployRawYaml"
            properties = {
                Octopus.Action.GitRepository.Source = "External"
                Octopus.Action.Kubernetes.DeploymentTimeout = "180"
                Octopus.Action.Kubernetes.ResourceStatusCheck = "True"
                Octopus.Action.Kubernetes.ServerSideApply.Enabled = "True"
                Octopus.Action.Kubernetes.ServerSideApply.ForceConflicts = "True"
                Octopus.Action.KubernetesContainers.CustomResourceYamlFileName = "kubernetes/argo-apps/#{Octopus.Environment.Name | ToLower}-taka.yaml"
                Octopus.Action.KubernetesContainers.Namespace = "argocd"
                Octopus.Action.Script.ScriptSource = "GitRepository"
            }
            worker_pool = "homelab-k8s"
            worker_pool_variable = ""

            git_dependencies {
                default_branch = "main"
                file_path_filters = ["kubernetes/argo-apps/#{Octopus.Environment.Name | ToLower}-taka.yaml"]
                git_credential_type = "GitHub"
                github_connection_id = "GitHubAppConnections-1"
                repository_uri = "https://github.com/BobJWalker/OctopusBlueprints.git"
            }
        }
    }
}